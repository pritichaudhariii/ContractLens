# Copy to .env for local runs (the app reads it automatically).

# ---- Providers ----------------------------------------------------------------
# Answer generation and the LLM judge. Without it the offline extractive fake is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a different (cheaper) model for the eval judge
# JUDGE_MODEL=claude-haiku-4-5

# Embeddings + reranking (voyage-law-2 is trained on legal text). Without it, deterministic
# hashing embeddings are used, which is fine for tests and demos.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-law-2
RERANK_MODEL=rerank-2.5

# ---- Storage --------------------------------------------------------------------
# Postgres with the pgvector extension. Without it an in-memory store is used.
DATABASE_URL=postgresql://contractlens:contractlens@localhost:5432/contractlens

# ---- Service ----------------------------------------------------------------------
# If set, every request must send X-API-Key: <value>
API_KEY=
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Retrieval tuning -----------------------------------------------------------
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=24
