# Copy to .env for local runs (the app reads it automatically).

# ---- Providers ----------------------------------------------------------------
# Azure AI Foundry: answer generation, embeddings and the LLM judge.
# Without it, the offline extractive model and deterministic hashing embeddings are used.
#   azure_openai style: https://<resource>.openai.azure.com          (models addressed by deployment name)
#   inference style:    https://<resource>.services.ai.azure.com/models (any model deployed in the project)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_STYLE=azure_openai
AZURE_FOUNDRY_API_VERSION=2024-10-21
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-4o-mini
# Optional: a stronger deployment to grade answers in the eval harness
# AZURE_FOUNDRY_JUDGE_DEPLOYMENT=gpt-4o
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_FOUNDRY_EMBEDDING_DIMENSION=1536

# Optional reranking with Voyage (rerank-2.5). Voyage embeddings and Anthropic generation
# are also supported as alternatives: set LLM_PROVIDER / EMBEDDING_PROVIDER explicitly.
VOYAGE_API_KEY=
RERANK_MODEL=rerank-2.5

# ---- Storage --------------------------------------------------------------------
# Postgres with the pgvector extension. Without it an in-memory store is used.
DATABASE_URL=postgresql://contractlens:contractlens@localhost:5432/contractlens

# ---- Service ----------------------------------------------------------------------
# If set, every request must send X-API-Key: <value>
API_KEY=
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Retrieval tuning -----------------------------------------------------------
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=24
